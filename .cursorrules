project:
  name: MagicSquare_JH
  domain: "4x4 Magic Square validation-first project"
  primary_goal: "제약(불변식) 기반 유효성 판정을 테스트로 고정하고 회귀 가능하게 유지"
  secondary_goal: "1차 판정 계약 안정화 이후 유효 격자 생성 기능 확장"
  magic_constant: 34
  grid_size: "4x4"

code_style:
  python_version: "3.10+"
  style_guide: "PEP8 엄격 준수"
  type_hints: "모든 함수 파라미터와 반환값에 필수"
  docstring: "Google 스타일, 모든 public 메서드에 필수"
  max_line_length: 88

architecture:
  pattern: "ECB (boundary/control/entity)"
  layers:
    boundary:
      responsibility: "외부 입출력 담당 (UI, API, CLI)"
      examples:
        - "CLI command handlers"
        - "API request/response adapters"
        - "input parsing and output formatting"
    control:
      responsibility: "비즈니스 로직 담당"
      examples:
        - "validation use-cases orchestration"
        - "workflow coordination"
        - "application service logic"
    entity:
      responsibility: "도메인 데이터 및 규칙 담당"
      examples:
        - "grid model"
        - "invariants and domain rules"
        - "pure domain validation logic"
  dependency_direction:
    allowed:
      - "boundary -> control"
      - "control -> entity"
    forbidden:
      - "boundary -> entity (직접 접근 금지)"
      - "entity -> control"
      - "entity -> boundary"
      - "control -> boundary"

tdd_rules:
  red_phase:
    description: "실패하는 테스트를 먼저 작성하고 실패를 확인하여 요구사항을 고정한다."
    rules:
      - "새 기능/버그 수정 전 반드시 실패 테스트를 먼저 추가한다."
      - "실패 원인이 요구사항과 직접 연결되는지 확인한다."
      - "테스트는 한 번에 하나의 행동/규칙을 검증한다."
    must_not:
      - "RED 확인 전에 구현 코드를 작성하지 않는다."
      - "테스트를 임시로 skip/xfail 처리해 통과처럼 보이게 하지 않는다."
      - "실패 원인을 흐리는 과도한 mocking을 사용하지 않는다."
  green_phase:
    description: "테스트를 통과시키는 최소 구현만 작성한다."
    rules:
      - "가장 작은 변경으로 RED 테스트를 GREEN으로 만든다."
      - "기존 테스트 스위트 전체가 통과해야 한다."
      - "의도와 무관한 기능 확장을 하지 않는다."
    must_not:
      - "리팩터링을 수행하지 않는다."
      - "성능/구조 개선을 이유로 요구사항 범위를 확장하지 않는다."
      - "테스트 약화(삭제, 완화, skip 추가)를 하지 않는다."
  refactor_phase:
    description: "기능 변경 없이 구조를 개선하고 가독성/유지보수성을 높인다."
    rules:
      - "외부 동작(입출력, 계약, 예외 의미)을 변경하지 않는다."
      - "중복 제거, 네이밍 개선, 모듈 분리 중심으로 수정한다."
      - "테스트 커버리지를 유지(최소 80%)하고 전체 테스트를 재실행한다."
    must_not:
      - "새 기능을 끼워 넣지 않는다."
      - "테스트 기대값을 구현에 맞춰 임의로 수정하지 않는다."
      - "커버리지를 낮추는 테스트 삭제를 하지 않는다."

testing:
  framework: "pytest"
  pattern: "AAA (Arrange-Act-Assert)"
  coverage_minimum: "80%"
  fixture_scope:
    default: "function"
    allowed:
      - "module (무거운 공용 셋업에 한해 제한적 사용)"
      - "session (외부 리소스 초기화가 필요한 경우만 승인 후 사용)"
    rules:
      - "픽스처는 테스트 간 상태 공유를 최소화한다."
      - "mutable fixture는 각 테스트에서 독립적으로 초기화한다."
  naming_convention: "모든 테스트 함수는 test_ 접두사 필수"

forbidden:
  - pattern: "print()"
    reason: "디버깅 출력은 테스트 신뢰성과 로그 품질을 저하시킨다."
    alternative: "pytest assertion 메시지, logging 모듈, debugger 사용"
  - pattern: "하드코딩 상수 (매직 넘버/문자열)"
    reason: "의미 불명 값은 도메인 규칙 변경 시 유지보수 비용을 증가시킨다."
    alternative: "named constant, enum, 설정값/도메인 상수 모듈 사용"
  - pattern: "except: (bare except)"
    reason: "예외 원인을 숨기고 결함 탐지를 어렵게 만든다."
    alternative: "구체 예외 타입 명시 (예: except ValueError as e)"
  - pattern: "테스트 약화 (skip 남발, assertion 제거, 기대조건 완화)"
    reason: "회귀 방지 계약을 훼손한다."
    alternative: "원인 분석 후 구현 수정 또는 테스트 목적에 맞는 픽스처 보강"
  - pattern: "RED 없이 구현 시작"
    reason: "요구사항 고정 없이 구현이 선행되어 TDD 규율이 깨진다."
    alternative: "실패 테스트 작성 및 실패 확인 후 구현 착수"

file_structure:
  # ECB 기준 권장 디렉터리 구조
  # MagicSquare_JH/
  # ├── boundary/
  # │   ├── api/
  # │   ├── cli/
  # │   └── dto/
  # ├── control/
  # │   ├── services/
  # │   └── use_cases/
  # ├── entity/
  # │   ├── models/
  # │   ├── rules/
  # │   └── constants.py
  # ├── tests/
  # │   ├── boundary/
  # │   ├── control/
  # │   ├── entity/
  # │   └── conftest.py
  # └── pyproject.toml
  policy:
    boundary_dir: "외부 인터페이스/입출력 코드만 배치"
    control_dir: "유스케이스 및 오케스트레이션 로직만 배치"
    entity_dir: "도메인 모델/규칙/불변식만 배치"
    tests_dir: "레이어별 미러링 구조 유지"

ai_behavior:
  before_code_generation:
    - "코드 작성 전 관련 테스트 파일 및 기존 실패 테스트를 먼저 확인한다."
    - "변경 대상이 속한 ECB 레이어와 의존성 방향을 먼저 검증한다."
    - "요구사항을 RED 테스트로 먼저 표현할 수 있는지 확인한다."
  during_code_generation:
    - "ECB 레이어 경계 위반 코드를 생성하지 않는다."
    - "타입힌트 없는 함수 생성 금지."
    - "Green 단계에서는 테스트 통과 최소 코드만 작성한다."
    - "print() 기반 디버깅 코드를 삽입하지 않는다."
  after_code_generation:
    - "전체 관련 테스트를 실행하고 AAA 패턴 위배 여부를 점검한다."
    - "커버리지 80% 이상 유지 여부를 확인한다."
    - "tdd_rules 위반이 감지되면 경고를 출력하고 변경을 재검토한다."
    - "리팩터링은 Refactor 단계에서만 수행했는지 확인한다."
